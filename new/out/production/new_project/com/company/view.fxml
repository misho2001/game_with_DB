<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="800.0" maxWidth="1546.0" prefHeight="800.0" prefWidth="1546.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.company.View">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <!-- ================= LOGIN SCREEN (Shows Java.jpg) ================= -->
            <AnchorPane fx:id="loginPane" prefHeight="800.0" prefWidth="1546.0">
               <children>
                  <ImageView fitHeight="800.0" fitWidth="877.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <image>
                        <Image url="@Java.jpg" />
                     </image>
                  </ImageView>

                  <Separator layoutX="873.0" orientation="VERTICAL" prefHeight="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0" />

                  <AnchorPane layoutX="880.0" prefHeight="800.0" prefWidth="666.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="880.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <effect>
                        <DropShadow>
                           <color>
                              <Color red="0.0" green="0.0" blue="0.0" opacity="0.1" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <Label layoutX="54.0" layoutY="120.0" text="Sign In">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>

                        <TextField fx:id="loginUsername" layoutX="54.0" layoutY="202.0" prefHeight="51.0" prefWidth="558.0" promptText="Username / Email" style="-fx-background-radius: 15;" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </TextField>

                        <PasswordField fx:id="loginPassword" layoutX="54.0" layoutY="270.0" prefHeight="51.0" prefWidth="558.0" promptText="Password" style="-fx-background-radius: 15;" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </PasswordField>

                        <Button defaultButton="true" layoutX="54.0" layoutY="345.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="48.0" prefWidth="558.0" styleClass="login-button" text="Log In" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Button>

                        <Button layoutX="54.0" layoutY="410.0" mnemonicParsing="false" styleClass="forgot-button" text="Forgot password?" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font name="Arial Bold" size="14.0" />
                           </font>
                        </Button>

                        <Separator layoutX="54.0" layoutY="480.0" prefWidth="558.0" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0" />

                        <Button layoutX="54.0" layoutY="510.0" mnemonicParsing="false" onAction="#showRegister" prefHeight="48.0" prefWidth="558.0" styleClass="create-button" text="Create new account" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Button>
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>

            <!-- ================= REGISTER SCREEN (Shows Sherlock.jpg) ================= -->
            <AnchorPane fx:id="registerPane" prefHeight="800.0" prefWidth="1546.0" visible="false">
               <children>
                  <ImageView fitHeight="800.0" fitWidth="877.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <image>
                        <Image url="@Sherlock.jpg" />
                     </image>
                  </ImageView>

                  <Separator layoutX="873.0" orientation="VERTICAL" prefHeight="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0" />

                  <AnchorPane layoutX="880.0" prefHeight="800.0" prefWidth="666.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="880.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <effect>
                        <DropShadow>
                           <color>
                              <Color red="0.0" green="0.0" blue="0.0" opacity="0.1" />
                           </color>
                        </DropShadow>
                     </effect>
                     <children>
                        <Label layoutX="54.0" layoutY="120.0" text="Create Account">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>

                        <TextField fx:id="regUsername" layoutX="54.0" layoutY="190.0" prefHeight="51.0" prefWidth="558.0" promptText="Full Name / Username" style="-fx-background-radius: 15;" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </TextField>

                        <TextField fx:id="regEmail" layoutX="54.0" layoutY="255.0" prefHeight="51.0" prefWidth="558.0" promptText="Email Address" style="-fx-background-radius: 15;" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </TextField>

                        <PasswordField fx:id="regPassword" layoutX="54.0" layoutY="320.0" prefHeight="51.0" prefWidth="558.0" promptText="Password" style="-fx-background-radius: 15;" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </PasswordField>

                        <PasswordField fx:id="regConfirmPassword" layoutX="54.0" layoutY="385.0" prefHeight="51.0" prefWidth="558.0" promptText="Confirm Password" style="-fx-background-radius: 15;" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </PasswordField>

                        <Button layoutX="54.0" layoutY="460.0" mnemonicParsing="false" onAction="#handleRegister" prefHeight="48.0" prefWidth="558.0" styleClass="create-button" text="Register" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Button>

                        <Separator layoutX="54.0" layoutY="530.0" prefWidth="558.0" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0" />

                        <Button layoutX="54.0" layoutY="560.0" mnemonicParsing="false" onAction="#showLogin" prefHeight="48.0" prefWidth="558.0" styleClass="login-button" text="Already have an account? Log in" AnchorPane.leftAnchor="54.0" AnchorPane.rightAnchor="54.0">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Button>
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>

            <!-- ================= GAME SCREEN ================= -->
            <!-- ================= GAME SCREEN ================= -->
            <AnchorPane fx:id="gamePane" prefHeight="800.0" prefWidth="1546.0" style="-fx-background-color: #1e1e2f;" visible="false">
               <children>
                  <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Label fx:id="welcomeLabel" text="Welcome to the Game!" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="36.0" />
                           </font>
                        </Label>

                        <!-- Random Target Number -->
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label text="Random Target Number:" textFill="#a0a0b0">
                                 <font>
                                    <Font size="22.0" />
                                 </font>
                              </Label>
                              <Label fx:id="randomNumberLabel" text="0" textFill="#00ffcc">
                                 <font>
                                    <Font name="System Bold" size="28.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>

                        <!-- Clickable Timer Button -->
                        <Button fx:id="timerButton" mnemonicParsing="false" onAction="#handleTimerClick" prefHeight="90.0" prefWidth="320.0" style="-fx-background-color: #3498db; -fx-background-radius: 20; -fx-cursor: hand;" text="Timer: 0.0s" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Button>

                        <Label fx:id="gameStatusLabel" text="Tap the timer button to stop and save!" textFill="#e0e0e0">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>

                        <Button mnemonicParsing="false" onAction="#showLogin" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-cursor: hand;" text="Log Out" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>

         </children>
      </StackPane>
   </children>
</AnchorPane>